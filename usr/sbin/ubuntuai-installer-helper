#!/usr/bin/env python3
"""pkexec helper. Allowlisted verbs only."""

from __future__ import annotations

import sys
from pathlib import Path

_HERE = Path(__file__).resolve()
_CANDIDATES = (
    Path("/usr/local/share/ubuntuai-installer"),
    Path("/usr/share/ubuntuai-installer"),
    _HERE.parents[1] / "share" / "ubuntuai-installer",
)
for _pkg in _CANDIDATES:
    if (_pkg / "apply.py").is_file():
        sys.path.insert(0, str(_pkg))
        break
else:
    sys.stderr.write("ubuntuai-installer-helper: cannot find apply.py\n")
    sys.exit(1)

from apply import add_user_to_groups, apt_install, write_core_files  # noqa: E402
from lemonade import publish  # noqa: E402
from users import target_for  # noqa: E402


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        sys.stderr.write("usage: ubuntuai-installer-helper <verb> [args]\n")
        return 2
    verb = argv[1]
    rest = argv[2:]
    if verb == "install":
        apt_install(rest)
        return 0
    if verb == "groups":
        if not rest:
            sys.stderr.write("groups requires USER GROUP...\n")
            return 2
        add_user_to_groups(rest[0], rest[1:])
        return 0
    if verb == "core-files":
        if len(rest) != 3:
            sys.stderr.write("core-files requires USER MODEL_ROOT BIND\n")
            return 2
        write_core_files(rest[0], rest[1], rest[2])
        return 0
    if verb == "lemonade-publish":
        if not rest:
            sys.stderr.write("lemonade-publish requires USER\n")
            return 2
        print(publish(target_for(rest[0])))
        return 0
    sys.stderr.write(f"unknown verb {verb}\n")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as exc:  # noqa: BLE001. helper must print and exit.
        sys.stderr.write(f"{exc}\n")
        sys.exit(1)
